NODE_ENV=development
APP_ENV=development
HOST=0.0.0.0
PORT=4003
API_PREFIX=/api/v1
PUBLIC_WEB_URL=https://de-3-ocop-len-san.pages.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
RATE_LIMIT_MAX=120

# Runtime PostgreSQL / Supabase Transaction Pooler URL (use non-owner role `ocop_runtime` in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocop_dong_nai
# Migration credential (owner/migration role only, never used at API runtime)
SUPABASE_DB_MIGRATION_URL=

# Supabase Auth verification (JWKS or Auth REST / JWT secret)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
JWT_SECRET=dev-only-change-this-secret-at-least-32-chars

# Cloudflare Turnstile verification
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=de-3-ocop-len-san.pages.dev,localhost

# Storage server-side signing secret (only needed for private bucket presigned URLs)
STORAGE_SIGNING_SECRET=
